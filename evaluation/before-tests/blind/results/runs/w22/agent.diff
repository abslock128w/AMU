@@ -61,6 +61,24 @@ def get_connection(backend=None, *, fail_silently=False, **kwds):
     return klass(fail_silently=fail_silently, **kwds)
 
 
+def _resolve_connection(connection, fail_silently, auth_user, auth_password):
+    if connection is None:
+        return get_connection(
+            username=auth_user, password=auth_password, fail_silently=fail_silently
+        )
+    for name, value in (
+        ("fail_silently", fail_silently),
+        ("auth_user", auth_user),
+        ("auth_password", auth_password),
+    ):
+        if value is not None and value is not False:
+            raise TypeError(
+                f"{name} cannot be used with a connection. "
+                "(Pass it to get_connection() instead.)"
+            )
+    return connection
+
+
