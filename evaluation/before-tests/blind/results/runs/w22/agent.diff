+class MailConnectionConflictTests(SimpleTestCase):
+    def test_send_mail(self):
+        conn = mail.get_connection()
+        for kwargs in (
+            {"fail_silently": True},
+            {"auth_user": "user"},
+            {"auth_password": "password"},
+        ):
+            with self.subTest(**kwargs), self.assertRaisesMessage(
+                TypeError, "cannot be used with a connection"
+            ):
+                send_mail(
+                    "subject", "body", "from@example.com", ["to@example.com"],
+                    connection=conn, **kwargs,
+                )
+
+    def test_send_mass_mail(self):
+        conn = mail.get_connection()
+        for kwargs in (
+            {"fail_silently": True},
+            {"auth_user": "user"},
+            {"auth_password": "password"},
+        ):
+            with self.subTest(**kwargs), self.assertRaisesMessage(
+                TypeError, "cannot be used with a connection"
+            ):
+                send_mass_mail([], connection=conn, **kwargs)
+
+    def test_email_message_send(self):
+        msg = EmailMessage(
+            "subject", "body", "from@example.com", ["to@example.com"],
+            connection=mail.get_connection(),
+        )
+        with self.assertRaisesMessage(TypeError, "fail_silently cannot be used"):
+            msg.send(fail_silently=True)
+
