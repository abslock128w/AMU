+++ b/django/forms/models.py
@@ -776,8 +776,13 @@ class BaseModelFormSet(BaseFormSet, AltersData):
             # If the queryset isn't already ordered we need to add an
             # artificial ordering here to make sure that all formsets
             # constructed from this queryset have the same form order.
-            if not qs.ordered:
-                qs = qs.order_by(self.model._meta.pk.name)
+            if not qs.totally_ordered:
+                # Keep any existing (non-deterministic) ordering and append
+                # the primary key as a tie-breaker.
+                ordering = list(qs.query.order_by)
+                if not ordering and qs.query.default_ordering:
+                    ordering = list(qs.query.get_meta().ordering)
+                qs = qs.order_by(*ordering, self.model._meta.pk.name)
 
             # Removed queryset limiting here. As per discussion re: #13023
