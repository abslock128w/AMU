+    def test_clash_between_related_name_and_manager_on_other_model(self):
+        class Target(models.Model):
+            objs = models.Manager()
+
+        class Source(models.Model):
+            fk = models.ForeignKey(
+                Target, related_name="objs", on_delete=models.CASCADE
+            )
+            m2m = models.ManyToManyField(Target, related_name="objs")
+
+        for name in ["fk", "m2m"]:
+            with self.subTest(name):
+                errors = Source._meta.get_field(name).check(from_model=Source)
+                self.assertIn("fields.E348", [e.id for e in errors])
+
+    def test_default_accessor_name_clash_with_manager(self):
+        class Target(models.Model):
+            source_set = models.Manager()
+
+        class Source(models.Model):
+            fk = models.ForeignKey(Target, on_delete=models.CASCADE)
+
+        self.assertEqual(
+            [e.id for e in Source._meta.get_field("fk").check()], ["fields.E348"]
+        )
+
+    def test_field_name_matching_manager_name_is_not_a_clash(self):
+        class Target(models.Model):
+            fk = models.Manager()
+
+        class Source(models.Model):
+            fk = models.ForeignKey(
+                Target, related_name="sources", on_delete=models.CASCADE
+            )
+
+        self.assertEqual(Source._meta.get_field("fk").check(), [])
