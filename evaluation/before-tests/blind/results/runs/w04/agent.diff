+        with self.assertWarnsMessage(RemovedInDjango70Warning, msg):
+            self.assertEqual(models.BLANK_CHOICE_DASH, [("", "---------")])
+        with self.assertWarnsMessage(RemovedInDjango70Warning, msg):
+            from django.db.models.fields import BLANK_CHOICE_DASH
+        self.assertEqual(BLANK_CHOICE_DASH, [("", "---------")])
