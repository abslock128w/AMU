 __all__ = [
     "BaseChoiceIterator",
     "BlankChoiceIterator",
     "CallableChoiceIterator",
     "flatten_choices",
+    "get_blank_choice_label",
     "normalize_choices",
 ]
 
 
+def get_blank_choice_label():
+    """
+    Return the label of the blank choice of <select> widgets, depending on the
+    USE_BLANK_CHOICE_DASH transitional setting.
+    """
+    # RemovedInDjango70Warning: Remove the setting and always return the
+    # translatable label.
+    if settings.USE_BLANK_CHOICE_DASH:
+        return "---------"
+    return gettext_lazy("(select an option)")
+
+
