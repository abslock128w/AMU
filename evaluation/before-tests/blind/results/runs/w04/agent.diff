+    def test_blank_choice_label_setting(self):
+        f = models.CharField(choices=[("a", "A")])
+        self.assertEqual(f.get_choices()[0], ("", "---------"))
+        with self.settings(USE_BLANK_CHOICE_DASH=False):
+            self.assertEqual(f.get_choices()[0], ("", "(select an option)"))
+            self.assertEqual(
+                models.BLANK_CHOICE_LABEL, [("", "(select an option)")]
+            )
+            self.assertEqual(
