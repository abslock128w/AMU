+    def test_get_queryset_adds_pk_to_non_unique_ordering(self):
+        # Author is ordered by a non-unique field, so the ordering is not
+        # total; pk is appended as a tie-breaker.
+        self.assertIs(Author._default_manager.get_queryset().totally_ordered, False)
+        AuthorFormSet = modelformset_factory(Author, fields="__all__")
+        queryset = AuthorFormSet().get_queryset()
+        self.assertEqual(queryset.query.order_by, ("name", "id"))
+        formset = AuthorFormSet(queryset=Author.objects.order_by("-name"))
+        queryset = formset.get_queryset()
+        self.assertEqual(queryset.query.order_by, ("-name", "id"))
