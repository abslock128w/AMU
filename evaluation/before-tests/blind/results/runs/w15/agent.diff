 from django.conf import settings
 from django.core.checks import Error
+from django.core.exceptions import ValidationError
 
 
 def check_site_id(app_configs, **kwargs):
-    if hasattr(settings, "SITE_ID") and not isinstance(
-        settings.SITE_ID, (NoneType, int)
-    ):
+    from django.contrib.sites.models import Site
+
+    site_id = getattr(settings, "SITE_ID", None)
+    if site_id is None:
+        return []
+    try:
+        # to_python() may coerce compatible values (e.g. "1" to 1); reject
+        # those since the setting must already have the primary key's type.
+        valid = site_id == Site._meta.pk.to_python(site_id)
+    except (ValidationError, TypeError, ValueError):
+        valid = False
+    if not valid:
         return [
             Error("The SITE_ID setting must be an integer", id="sites.E101"),
         ]
