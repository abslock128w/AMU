+    def test_clash_between_related_name_and_manager_on_target(self):
+        class Target(models.Model):
+            authors = models.Manager()
+
+        class Source(models.Model):
+            target = models.ForeignKey(
+                Target, related_name="authors", on_delete=models.CASCADE
+            )
+
+        self.assertEqual(
+            Source.check(),
+            [
+                Error(
+                    "Related name 'authors' for 'Source.target' clashes with the "
+                    "name of a model manager.",
+                    hint=(
+                        "Rename the model manager or change the related_name argument "
+                        "in the definition for field 'Source.target'."
+                    ),
+                    obj=Source._meta.get_field("target"),
+                    id="fields.E348",
+                )
+            ],
+        )
+
+    def test_default_accessor_clash_with_manager(self):
+        class Target(models.Model):
+            source_set = models.Manager()
+
+        class Source(models.Model):
+            target = models.ForeignKey(Target, on_delete=models.CASCADE)
+
+        self.assertEqual(len(Source.check()), 1)
+        self.assertEqual(Source.check()[0].id, "fields.E348")
+
+    def test_field_name_matching_manager_is_not_a_clash(self):
+        class Target(models.Model):
+            pass
+
+        class Source(models.Model):
