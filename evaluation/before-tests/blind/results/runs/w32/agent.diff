+    def test_get_queryset_adds_pk_when_ordering_not_total(self):
+        # Author is ordered by a non-unique field, so the ordering isn't
+        # deterministic.
+        self.assertIs(Author.objects.all().totally_ordered, False)
+        AuthorFormSet = modelformset_factory(Author, fields="__all__")
+        formset = AuthorFormSet()
+        self.assertEqual(formset.get_queryset().query.order_by, ("id",))
+
+    def test_get_queryset_keeps_total_ordering(self):
+        qs = Author.objects.order_by("name", "pk")
+        self.assertIs(qs.totally_ordered, True)
+        AuthorFormSet = modelformset_factory(Author, fields="__all__")
+        formset = AuthorFormSet(queryset=qs)
+        self.assertEqual(formset.get_queryset().query.order_by, ("name", "pk"))
