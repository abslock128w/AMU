+    def test_clash_between_related_name_and_manager_of_other_model(self):
+        class Author(models.Model):
+            authors = models.Manager()
+
+        class Book(models.Model):
+            author = models.ForeignKey(
+                Author, related_name="authors", on_delete=models.CASCADE
+            )
+
+        self.assertEqual(
+            Book.check(),
+            [
+                Error(
+                    "Related name 'authors' for 'Book.author' clashes with the name "
+                    "of a model manager.",
+                    hint=(
+                        "Rename the model manager or change the related_name argument "
+                        "in the definition for field 'Book.author'."
+                    ),
+                    obj=Book._meta.get_field("author"),
+                    id="fields.E348",
+                )
+            ],
+        )
+
+    def test_clash_between_related_name_and_manager_of_other_model_one_to_one(self):
+        class Author(models.Model):
+            authors = models.Manager()
+
+        class Profile(models.Model):
+            author = models.OneToOneField(
+                Author, related_name="authors", on_delete=models.CASCADE
+            )
+
+        self.assertEqual(
+            Profile.check(),
+            [
+                Error(
+                    "Related name 'authors' for 'Profile.author' clashes with the "
+                    "name of a model manager.",
+                    hint=(
+                        "Rename the model manager or change the related_name argument "
+                        "in the definition for field 'Profile.author'."
+                    ),
+                    obj=Profile._meta.get_field("author"),
+                    id="fields.E348",
+                )
+            ],
+        )
+
+    def test_default_accessor_does_not_clash_with_manager(self):
+        # The default accessor is "<model>_set", so a manager named after the
+        # model (the reverse query name) doesn't clash.
+        class Author(models.Model):
+            book = models.Manager()
+
+        class Book(models.Model):
+            author = models.ForeignKey(Author, on_delete=models.CASCADE)
+
+        self.assertEqual(Book.check(), [])
+        self.assertEqual(Author.check(), [])
+
+    def test_no_duplicate_error_for_other_fields_clash(self):
+        # A clash caused by one field must only be reported for that field.
+        class Author(models.Model):
+            authors = models.Manager()
+
+        class Book(models.Model):
+            author = models.ForeignKey(
+                Author, related_name="written", on_delete=models.CASCADE
+            )
+            editor = models.ForeignKey(
+                Author, related_name="authors", on_delete=models.CASCADE
+            )
+
+        self.assertEqual(
+            Book.check(),
+            [
+                Error(
+                    "Related name 'authors' for 'Book.editor' clashes with the name "
+                    "of a model manager.",
+                    hint=(
+                        "Rename the model manager or change the related_name argument "
+                        "in the definition for field 'Book.editor'."
+                    ),
+                    obj=Book._meta.get_field("editor"),
+                    id="fields.E348",
+                )
+            ],
+        )
+
 
