+# The label of the blank choice shown in <select> dropdowns.
+BLANK_CHOICE_LABEL = _("(select an option)")
+
+
+def _get_blank_choice_label():
+    # Evaluated on each use so that the USE_BLANK_CHOICE_DASH setting can be
+    # changed at runtime (e.g. with override_settings()).
+    if settings.USE_BLANK_CHOICE_DASH:
+        # RemovedInDjango70Warning: Remove this branch when the transitional
+        # USE_BLANK_CHOICE_DASH setting is removed.
+        warnings.warn(
+            "The USE_BLANK_CHOICE_DASH setting is deprecated. Use a custom "
+            "label for blank choices instead.",
+            category=RemovedInDjango70Warning,
+            skip_file_prefixes=django_file_prefixes(),
+        )
+        return "---------"
+    return BLANK_CHOICE_LABEL
+
+
+# Lazily resolved so that the label honours the USE_BLANK_CHOICE_DASH setting.
+DEFAULT_BLANK_CHOICE_LABEL = lazy(_get_blank_choice_label, str)()
+BLANK_CHOICE_DEFAULT = [("", DEFAULT_BLANK_CHOICE_LABEL)]
+
 
