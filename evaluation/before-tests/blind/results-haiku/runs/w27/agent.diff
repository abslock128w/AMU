diff --git a/tests/deprecation/tests.py b/tests/deprecation/tests.py
index ac610b4..609a4e5 100644
--- a/tests/deprecation/tests.py
+++ b/tests/deprecation/tests.py
@@ -31,7 +31,17 @@ class DjangoFilePrefixesTests(SimpleTestCase):
         prefixes = django_file_prefixes()
         self.assertIsInstance(prefixes, tuple)
         self.assertEqual(len(prefixes), 1)
-        self.assertTrue(prefixes[0].endswith(f"{os.path.sep}django"))
+        self.assertTrue(prefixes[0].endswith(f"{os.path.sep}django{os.path.sep}"))
+
+    def test_trailing_separator_excludes_sibling_packages(self):
+        # A sibling package whose name starts with "django" must not match
+        # the prefix, otherwise its frames would be skipped by warnings.
+        (prefix,) = django_file_prefixes()
+        site_packages = os.path.dirname(prefix.rstrip(os.path.sep))
+        sibling_file = os.path.join(site_packages, "django_goodies", "__init__.py")
+        django_file = os.path.join(prefix, "__init__.py")
+        self.assertFalse(sibling_file.startswith(prefix))
+        self.assertTrue(django_file.startswith(prefix))
 
 
