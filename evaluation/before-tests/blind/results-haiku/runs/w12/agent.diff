         )
 
 
+class MailConnectionConflictTests(SimpleTestCase):
+    """
+    fail_silently, auth_user and auth_password can only be passed to
+    get_connection() when a connection is given to the mail APIs.
+    """
+
+    def setUp(self):
+        self.connection = locmem.EmailBackend()
+
+    def assertConflict(self, msg, **kwargs):
+        with self.assertRaisesMessage(TypeError, msg):
+            send_mail(
+                "subject",
+                "message",
+                "from@example.com",
+                ["to@example.com"],
+                connection=self.connection,
+                **kwargs,
+            )
+
+    def test_send_mail_fail_silently_with_connection(self):
+        msg = (
+            "fail_silently cannot be used with a connection. "
+            "(Pass fail_silently to get_connection() instead.)"
+        )
+        for value in (True, False):
+            with self.subTest(fail_silently=value):
+                self.assertConflict(msg, fail_silently=value)
+
+    def test_send_mail_auth_with_connection(self):
+        with self.subTest("auth_user"):
+            self.assertConflict(
+                "auth_user cannot be used with a connection.", auth_user="user"
+            )
+        with self.subTest("auth_password"):
+            self.assertConflict(
+                "auth_password cannot be used with a connection.",
+                auth_password="password",
+            )
+
+    def test_send_mass_mail_conflicts_with_connection(self):
+        datatuple = [("subject", "message", "from@example.com", ["to@example.com"])]
+        with self.assertRaisesMessage(
+            TypeError, "fail_silently cannot be used with a connection."
+        ):
+            send_mass_mail(datatuple, fail_silently=True, connection=self.connection)
+        with self.assertRaisesMessage(
+            TypeError, "auth_user cannot be used with a connection."
+        ):
+            send_mass_mail(datatuple, auth_user="user", connection=self.connection)
+        with self.assertRaisesMessage(
+            TypeError, "auth_password cannot be used with a connection."
+        ):
+            send_mass_mail(
+                datatuple, auth_password="password", connection=self.connection
+            )
+
+    @override_settings(
+        ADMINS=["admin@example.com"],
+        MANAGERS=["manager@example.com"],
+        EMAIL_BACKEND="django.core.mail.backends.locmem.EmailBackend",
+    )
+    def test_mail_admins_and_managers_conflict_with_connection(self):
+        for func in (mail_admins, mail_managers):
+            with self.subTest(func=func.__name__):
+                with self.assertRaisesMessage(
+                    TypeError, "fail_silently cannot be used with a connection."
+                ):
+                    func(
+                        "subject",
+                        "message",
+                        fail_silently=True,
+                        connection=self.connection,
+                    )
+
+    def test_email_message_send_fail_silently_with_connection(self):
+        email = EmailMessage(
+            "subject",
+            "body",
+            "from@example.com",
+            ["to@example.com"],
+            connection=self.connection,
+        )
+        with self.assertRaisesMessage(
+            TypeError, "fail_silently cannot be used with a connection."
+        ):
+            email.send(fail_silently=True)
+        with self.assertRaisesMessage(
+            TypeError, "fail_silently cannot be used with a connection."
+        ):
+            email.get_connection(fail_silently=False)
+        # Without fail_silently, the given connection is used.
+        self.assertEqual(email.send(), 1)
+
+    @override_settings(EMAIL_BACKEND="django.core.mail.backends.locmem.EmailBackend")
+    def test_send_mail_fail_silently_is_passed_to_get_connection(self):
+        with mock.patch("django.core.mail.get_connection") as get_connection:
+            send_mail("subject", "message", "from@example.com", ["to@example.com"])
+        get_connection.assert_called_once_with(
+            username=None, password=None, fail_silently=False
+        )
+        with mock.patch("django.core.mail.get_connection") as get_connection:
+            send_mail(
+                "subject",
+                "message",
+                "from@example.com",
+                ["to@example.com"],
+                fail_silently=True,
+                auth_user="user",
+                auth_password="password",
+            )
+        get_connection.assert_called_once_with(
+            username="user", password="password", fail_silently=True
+        )
+
+    @override_settings(EMAIL_BACKEND="django.core.mail.backends.locmem.EmailBackend")
+    def test_email_message_send_fail_silently_is_passed_to_get_connection(self):
+        email = EmailMessage("subject", "body", "from@example.com", ["to@example.com"])
+        with mock.patch("django.core.mail.get_connection") as get_connection:
+            get_connection.return_value = self.connection
+            email.send()
+            get_connection.assert_called_once_with(fail_silently=False)
+        # send() doesn't cache a connection, so fail_silently can be given on a
+        # later call.
+        self.assertIsNone(email.connection)
+        self.assertEqual(email.send(fail_silently=True), 1)
+
