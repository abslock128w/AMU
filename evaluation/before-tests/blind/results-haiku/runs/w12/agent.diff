+def _get_connection_for_send(
+    *, fail_silently, auth_user, auth_password, connection
+):
+    """
+    Return the connection to send with. Raise TypeError if a connection is
+    given along with arguments that can only be passed to get_connection().
+    """
+    if connection is None:
+        return get_connection(
+            username=auth_user,
+            password=auth_password,
+            fail_silently=bool(fail_silently),
+        )
+    if fail_silently is not None:
+        raise TypeError(_FAIL_SILENTLY_WITH_CONNECTION_MSG)
+    if auth_user is not None:
+        raise TypeError(_AUTH_USER_WITH_CONNECTION_MSG)
+    if auth_password is not None:
+        raise TypeError(_AUTH_PASSWORD_WITH_CONNECTION_MSG)
+    return connection
+
