+    def test_get_queryset_keeps_totally_ordered_queryset(self):
+        # Book is ordered by its unique primary key, so the queryset is
+        # totally ordered and the explicit ordering is preserved.
+        queryset = Book.objects.order_by("-id")
+        self.assertIs(queryset.totally_ordered, True)
+
+        BookFormSet = modelformset_factory(Book, fields="__all__")
+        formset = BookFormSet(queryset=queryset)
+
+        self.assertEqual(formset.get_queryset().query.order_by, ("-id",))
+
+    def test_get_queryset_adds_pk_tiebreaker_to_non_unique_ordering(self):
+        # Author is ordered by the non-unique "name" field, so the queryset
+        # is not totally ordered. The existing ordering is kept and the primary
+        # key is appended as a tiebreaker.
+        queryset = Author.objects.all()
+        self.assertIs(queryset.ordered, True)
+        self.assertIs(queryset.totally_ordered, False)
+
+        AuthorFormSet = modelformset_factory(Author, fields="__all__")
+        formset = AuthorFormSet(queryset=queryset)
+
+        self.assertEqual(formset.get_queryset().query.order_by, ("name", "id"))
+
+    def test_get_queryset_keeps_explicit_non_unique_ordering(self):
+        # An explicit ordering on a non-unique field is kept and the primary
+        # key is appended as a tiebreaker.
+        AuthorFormSet = modelformset_factory(Author, fields="__all__")
+        formset = AuthorFormSet(queryset=Author.objects.order_by("-name"))
+
+        self.assertEqual(formset.get_queryset().query.order_by, ("-name", "id"))
+
