index 851d1c3..692615b 100644
--- a/tests/mail/tests.py
+++ b/tests/mail/tests.py
@@ -2000,6 +2000,126 @@ class MailTests(MailTestsMixin, SimpleTestCase):
         )
 
 
+class MailConnectionArgsTests(SimpleTestCase):
+    """
+    fail_silently, auth_user and auth_password are set through get_connection()
+    and can't be combined with an explicit connection.
+    """
+
+    fail_silently_msg = (
+        "fail_silently cannot be used with a connection. "
+        "Pass fail_silently to get_connection() instead."
+    )
+
+    def test_send_mail_fail_silently_with_connection(self):
+        connection = mail.get_connection()
+        for fail_silently in (True, False):
+            with self.subTest(fail_silently=fail_silently):
+                with self.assertRaisesMessage(TypeError, self.fail_silently_msg):
+                    send_mail(
+                        "subject",
+                        "message",
+                        "from@example.com",
+                        ["to@example.com"],
+                        fail_silently=fail_silently,
+                        connection=connection,
+                    )
+        self.assertEqual(len(mail.outbox), 0)
+
+    def test_send_mail_auth_with_connection(self):
+        connection = mail.get_connection()
+        cases = [
+            ({"auth_user": "username"}, "auth_user cannot be used with a connection."),
+            (
+                {"auth_password": "password"},
+                "auth_password cannot be used with a connection.",
+            ),
+        ]
+        for kwargs, msg in cases:
+            with self.subTest(kwargs=kwargs):
+                with self.assertRaisesMessage(TypeError, msg):
+                    send_mail(
+                        "subject",
+                        "message",
+                        "from@example.com",
+                        ["to@example.com"],
+                        connection=connection,
+                        **kwargs,
+                    )
+        self.assertEqual(len(mail.outbox), 0)
+
+    def test_send_mass_mail_fail_silently_with_connection(self):
+        connection = mail.get_connection()
+        datatuple = (("subject", "message", "from@example.com", ["to@example.com"]),)
+        with self.assertRaisesMessage(TypeError, self.fail_silently_msg):
+            send_mass_mail(datatuple, fail_silently=True, connection=connection)
+        with self.assertRaisesMessage(
+            TypeError, "auth_user cannot be used with a connection."
+        ):
+            send_mass_mail(datatuple, auth_user="username", connection=connection)
+        with self.assertRaisesMessage(
+            TypeError, "auth_password cannot be used with a connection."
+        ):
+            send_mass_mail(datatuple, auth_password="password", connection=connection)
+        self.assertEqual(len(mail.outbox), 0)
+
+    @override_settings(ADMINS=["admin@example.com"], MANAGERS=["manager@example.com"])
+    def test_mail_admins_and_managers_fail_silently_with_connection(self):
+        connection = mail.get_connection()
+        with self.assertRaisesMessage(TypeError, self.fail_silently_msg):
+            mail_admins("subject", "message", fail_silently=True, connection=connection)
+        with self.assertRaisesMessage(TypeError, self.fail_silently_msg):
+            mail_managers(
+                "subject", "message", fail_silently=False, connection=connection
+            )
+        self.assertEqual(len(mail.outbox), 0)
+
+    def test_email_message_send_fail_silently_with_connection(self):
+        email = EmailMessage(
+            "subject",
+            "message",
+            "from@example.com",
+            ["to@example.com"],
+            connection=mail.get_connection(),
+        )
+        with self.assertRaisesMessage(TypeError, self.fail_silently_msg):
+            email.send(fail_silently=True)
+        self.assertEqual(email.send(), 1)
+        self.assertEqual(len(mail.outbox), 1)
+
+    def test_email_message_send_fail_silently_without_connection(self):
+        email = EmailMessage(
+            "subject", "message", "from@example.com", ["to@example.com"]
+        )
+        # The default connection is created with fail_silently, and is reused
+        # by later sends, so repeating the argument is not an error.
+        self.assertEqual(email.send(fail_silently=True), 1)
+        self.assertEqual(email.send(fail_silently=True), 1)
+        self.assertEqual(email.send(), 1)
+        self.assertEqual(len(mail.outbox), 3)
+
+    def test_send_mail_default_connection_fail_silently(self):
+        with mock.patch("django.core.mail.get_connection") as get_connection:
+            send_mail(
+                "subject", "message", "from@example.com", ["to@example.com"]
+            )
+            get_connection.assert_called_with(
+                username=None, password=None, fail_silently=False
+            )
+            send_mail(
+                "subject",
+                "message",
+                "from@example.com",
+                ["to@example.com"],
+                fail_silently=True,
+                auth_user="username",
+                auth_password="password",
+            )
+            get_connection.assert_called_with(
+                username="username", password="password", fail_silently=True
+            )
+
+
