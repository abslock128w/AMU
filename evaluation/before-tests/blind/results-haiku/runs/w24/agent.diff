+    def test_get_queryset_adds_pk_tiebreaker_when_ordering_not_total(self):
+        # Author is ordered by a non-unique field, so its ordering is not
+        # totally ordered and the formset must add a pk tiebreaker while
+        # keeping the model's ordering.
+        self.assertIs(Author._default_manager.get_queryset().ordered, True)
+        self.assertIs(Author._default_manager.get_queryset().totally_ordered, False)
+
+        AuthorFormSet = modelformset_factory(Author, fields="__all__")
+        formset = AuthorFormSet()
+
+        queryset = formset.get_queryset()
+        self.assertIs(queryset.totally_ordered, True)
+        self.assertEqual(queryset.query.order_by, ("name", "id"))
+
+    def test_get_queryset_keeps_explicit_ordering_when_not_total(self):
+        # An explicit, non-unique ordering given to the formset is respected
+        # and only gets the pk tiebreaker appended.
+        AuthorFormSet = modelformset_factory(Author, fields="__all__")
+        formset = AuthorFormSet(queryset=Author.objects.order_by("-name"))
+
+        queryset = formset.get_queryset()
+        self.assertIs(queryset.totally_ordered, True)
+        self.assertEqual(queryset.query.order_by, ("-name", "id"))
+
+    def test_get_queryset_keeps_totally_ordered_queryset(self):
+        # Book is ordered by its unique pk, so the queryset is already
+        # totally ordered and the formset must not override its ordering.
+        self.assertIs(Book._default_manager.get_queryset().totally_ordered, True)
+
+        BookFormSet = modelformset_factory(Book, fields="__all__")
+        formset = BookFormSet()
+
+        queryset = formset.get_queryset()
+        self.assertEqual(queryset.query.order_by, ())
+        self.assertIs(queryset.query.default_ordering, True)
+
