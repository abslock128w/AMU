+    if not hasattr(settings, "SITE_ID") or settings.SITE_ID is None:
+        return []
+    try:
+        pk = apps.get_model("sites", "Site")._meta.pk
+    except LookupError:
+        # The sites framework isn't installed; fall back to the default
+        # integer primary key.
+        pk = AutoField()
+    try:
+        # to_python() may coerce values (e.g. "1" -> 1 for AutoField), so the
+        # value must also be unchanged by the conversion.
+        is_valid = settings.SITE_ID == pk.to_python(settings.SITE_ID)
+    except ValidationError:
+        is_valid = False
+    if is_valid:
+        return []
+    if isinstance(pk, IntegerField):
+        msg = "The SITE_ID setting must be an integer"
+    else:
+        msg = f"The SITE_ID setting must be a valid {pk.__class__.__name__} value"
+    return [checks.Error(msg, id="sites.E101")]
