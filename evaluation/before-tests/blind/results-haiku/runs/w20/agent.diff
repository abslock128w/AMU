diff --git a/tests/model_fields/test_blank_choice.py b/tests/model_fields/test_blank_choice.py
new file mode 100644
index 0000000..b50f303
--- /dev/null
+++ b/tests/model_fields/test_blank_choice.py
@@ -0,0 +1,72 @@
+from django import forms
+from django.contrib.auth.models import Group
+from django.db import models
+from django.db.models.fields import BLANK_CHOICE_LABEL
+from django.test import SimpleTestCase, override_settings
+from django.utils.deprecation import RemovedInDjango70Warning
+
+
+class BlankChoiceLabelTests(SimpleTestCase):
+    def test_blank_choice_label_constant(self):
+        self.assertEqual(BLANK_CHOICE_LABEL, "(select an option)")
+
+    def test_get_choices_default_blank_label(self):
+        f = models.CharField(choices=[("a", "A")])
+        self.assertEqual(
+            list(f.get_choices(include_blank=True)),
+            [("", "(select an option)"), ("a", "A")],
+        )
+
+    def test_get_choices_custom_blank_choice(self):
+        f = models.CharField(choices=[("a", "A")])
+        self.assertEqual(
+            list(f.get_choices(include_blank=True, blank_choice=[("", "None")])),
+            [("", "None"), ("a", "A")],
+        )
+
+    def test_model_choice_field_default_empty_label(self):
+        field = forms.ModelChoiceField(queryset=Group.objects.none())
+        self.assertEqual(field.empty_label, "(select an option)")
+
+    def test_model_choice_field_explicit_empty_label(self):
+        field = forms.ModelChoiceField(
+            queryset=Group.objects.none(), empty_label="(Nothing)"
+        )
+        self.assertEqual(field.empty_label, "(Nothing)")
+
+    def test_model_choice_field_no_empty_label(self):
+        field = forms.ModelChoiceField(queryset=Group.objects.none(), empty_label=None)
+        self.assertIsNone(field.empty_label)
+
+    @override_settings(USE_BLANK_CHOICE_DASH=True)
+    def test_use_blank_choice_dash_setting(self):
+        f = models.CharField(choices=[("a", "A")])
+        msg = "The USE_BLANK_CHOICE_DASH setting is deprecated."
+        with self.assertWarnsMessage(RemovedInDjango70Warning, msg):
+            choices = list(f.get_choices(include_blank=True))
+        self.assertEqual(choices, [("", "---------"), ("a", "A")])
+        with self.assertWarnsMessage(RemovedInDjango70Warning, msg):
+            field = forms.ModelChoiceField(queryset=Group.objects.none())
+        self.assertEqual(field.empty_label, "---------")
+
+    @override_settings(USE_BLANK_CHOICE_DASH=False)
+    def test_use_blank_choice_dash_setting_false(self):
+        f = models.CharField(choices=[("a", "A")])
+        self.assertEqual(
+            list(f.get_choices(include_blank=True))[0], ("", "(select an option)")
+        )
+
+    def test_deprecated_blank_choice_dash_constant(self):
+        from django.db.models import fields
+
+        msg = "BLANK_CHOICE_DASH is deprecated. Use BLANK_CHOICE_LABEL instead."
+        with self.assertWarnsMessage(RemovedInDjango70Warning, msg):
+            value = fields.BLANK_CHOICE_DASH
+        self.assertEqual(value, [("", "---------")])
+        with self.assertWarnsMessage(RemovedInDjango70Warning, msg):
+            value = models.BLANK_CHOICE_DASH
+        self.assertEqual(value, [("", "---------")])
+
+    def test_unknown_attribute(self):
+        with self.assertRaises(AttributeError):
+            models.NOT_A_REAL_CONSTANT
