 __all__ = [
+    "BLANK_CHOICE_LABEL",
     "BaseChoiceIterator",
     "BlankChoiceIterator",
     "CallableChoiceIterator",
     "flatten_choices",
+    "get_blank_choice_label",
     "normalize_choices",
 ]
 
+# The label of the blank choice in <select> choices.
+BLANK_CHOICE_LABEL = _("(select an option)")
+
+
+def get_blank_choice_label():
+    """
+    Return the label of the blank choice in <select> choices, as configured by
+    the (deprecated) USE_BLANK_CHOICE_DASH setting.
+    """
+    if settings.USE_BLANK_CHOICE_DASH:
+        warnings.warn(
+            "The USE_BLANK_CHOICE_DASH setting is deprecated. Remove it to use "
+            "the accessible blank choice label, django.db.models.fields."
+            "BLANK_CHOICE_LABEL.",
+            RemovedInDjango70Warning,
+            stacklevel=2,
+        )
+        return "---------"
+    return BLANK_CHOICE_LABEL
+
 
