+    def test_get_queryset_falls_back_to_pk_when_ordering_not_totally_ordered(self):
+        # Author's Meta.ordering is on the non-unique "name" field, so the
+        # queryset is ordered but not totally ordered. The formset must add
+        # the primary key to get a stable form order.
+        qs = Author.objects.all()
+        self.assertIs(qs.ordered, True)
+        self.assertIs(qs.totally_ordered, False)
+
+        AuthorFormSet = modelformset_factory(Author, fields="__all__")
+        formset = AuthorFormSet(queryset=qs)
+        self.assertEqual(formset.get_queryset().query.order_by, ("id",))
+
+    def test_get_queryset_keeps_totally_ordered_queryset(self):
+        # Ordering by a unique field is totally ordered, so the formset must
+        # keep the caller's ordering rather than replacing it with the pk.
+        qs = Author.objects.order_by("-pk")
+        self.assertIs(qs.totally_ordered, True)
+
+        AuthorFormSet = modelformset_factory(Author, fields="__all__")
+        formset = AuthorFormSet(queryset=qs)
+        self.assertEqual(formset.get_queryset().query.order_by, ("-pk",))
+
