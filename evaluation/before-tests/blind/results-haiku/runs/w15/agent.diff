+    def test_check_site_id_rejects_values_coerced_by_pk(self):
+        # AutoField.to_python() coerces these to int, but they aren't ints.
+        for site_id in ["1", 1.0, True]:
+            with self.subTest(site_id=site_id), self.settings(SITE_ID=site_id):
+                self.assertEqual(
+                    check_site_id(None),
+                    [
+                        checks.Error(
+                            msg="The SITE_ID setting must be an integer",
+                            id="sites.E101",
+                        ),
+                    ],
+                )
+
+    def test_check_site_id_rejects_invalid_pk_value(self):
+        with self.settings(SITE_ID="abc"):
+            self.assertEqual(
+                check_site_id(None),
+                [
+                    checks.Error(
+                        msg="The SITE_ID setting must be an integer",
+                        id="sites.E101",
+                    ),
+                ],
+            )
+
+    def test_check_site_id_uses_site_pk_field(self):
+        # A non-integer primary key (e.g. MongoDB's ObjectId) accepts the
+        # value as-is, so the check must not reject it.
+        pk = Field(primary_key=True)
+        with (
+            mock.patch.object(Site._meta, "pk", pk),
+            self.settings(SITE_ID="507f1f77bcf86cd799439011"),
