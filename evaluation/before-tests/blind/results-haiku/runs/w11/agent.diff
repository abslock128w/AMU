+    def test_get_queryset_adds_pk_tiebreaker_when_ordering_is_not_total(self):
+        # Author is ordered by a non-unique field, so the default queryset is
+        # ordered but not totally ordered. The primary key is appended as a
+        # tiebreaker rather than replacing the existing ordering.
+        self.assertIs(Author._default_manager.get_queryset().ordered, True)
+        self.assertIs(Author._default_manager.get_queryset().totally_ordered, False)
+
+        AuthorFormSet = modelformset_factory(Author, fields="__all__")
+        formset = AuthorFormSet()
+
+        queryset = formset.get_queryset()
+        self.assertEqual(queryset.query.order_by, ("name", "id"))
+
+    def test_get_queryset_keeps_explicit_ordering_and_adds_pk_tiebreaker(self):
+        # An explicit non-unique ordering is kept, with the primary key
+        # appended, so the user-specified display order still applies.
+        AuthorFormSet = modelformset_factory(Author, fields="__all__")
+        queryset = Author.objects.order_by("-name")
+        self.assertIs(queryset.totally_ordered, False)
+
+        formset = AuthorFormSet(queryset=queryset)
+
+        self.assertEqual(formset.get_queryset().query.order_by, ("-name", "id"))
+
+    def test_get_queryset_keeps_totally_ordered_queryset(self):
+        # Book is ordered by its primary key, which makes the ordering total,
+        # so the queryset is used unchanged.
+        self.assertIs(Book._default_manager.get_queryset().totally_ordered, True)
+
+        BookFormSet = modelformset_factory(Book, fields="__all__")
+        queryset = Book._default_manager.get_queryset()
+        formset = BookFormSet(queryset=queryset)
+
+        self.assertIs(formset.get_queryset(), queryset)
+
