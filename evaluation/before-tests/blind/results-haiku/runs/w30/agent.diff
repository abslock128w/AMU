+    def test_clash_between_related_name_and_manager_of_related_model(self):
+        class Author(models.Model):
+            authors = models.Manager()
+
+        class Book(models.Model):
+            author = models.ForeignKey(
+                Author, related_name="authors", on_delete=models.CASCADE
+            )
+
+        self.assertEqual(
+            Book.check(),
+            [
+                Error(
+                    "Related name 'authors' for 'Book.author' clashes with the name "
+                    "of a model manager.",
+                    hint=(
