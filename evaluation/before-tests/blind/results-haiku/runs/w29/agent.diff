+    def test_clash_between_related_name_and_target_manager(self):
+        class Author(models.Model):
+            books_by = models.Manager()
+
+        class Book(models.Model):
+            author = models.ForeignKey(
+                Author, related_name="books_by", on_delete=models.CASCADE
+            )
+
+        self.assertEqual(
+            Book.check(),
+            [
+                Error(
+                    "Related name 'books_by' for 'Book.author' clashes with the name "
+                    "of a model manager.",
+                    hint=(
+                        "Rename the model manager or change the related_name argument "
+                        "in the definition for field 'Book.author'."
+                    ),
+                    obj=Book._meta.get_field("author"),
+                    id="fields.E348",
+                )
+            ],
+        )
+
+    def test_clash_between_default_accessor_and_target_manager(self):
+        class Publisher(models.Model):
+            imprint_set = models.Manager()
+
+        class Imprint(models.Model):
+            publisher = models.ForeignKey(Publisher, on_delete=models.CASCADE)
+
+        self.assertEqual(
