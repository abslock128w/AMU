+        if isinstance(self.remote_field.model, str) or self.remote_field.hidden:
+            return errors
+        accessor_name = self.remote_field.get_accessor_name()
+        if accessor_name is None:
+            return errors
+        manager_names = {
+            manager.name for manager in self.remote_field.model._meta.managers
+        }
+        if accessor_name in manager_names:
+            field_name = f"{self.model._meta.object_name}.{self.name}"
+            errors.append(
