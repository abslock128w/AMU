+
+
+def test_trigsimp_leaves_independent_terms():
+    x, y = symbols('x,y')
+    rest = (y**2 - 1)/(y - 1)
+    assert trigsimp(rest + sin(x)**2 + cos(x)**2) == 1 + rest
+    assert trigsimp(rest + 1 - sin(x)**2) == rest + cos(x)**2
+    assert trigsimp((x**2 - 1)/(x - 1) + sin(x)**2 + cos(x)**2) == x + 2
