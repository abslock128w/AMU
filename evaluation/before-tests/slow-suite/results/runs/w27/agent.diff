+def elementwise_function(func):
+    """Return the function to display for an elementwise application
+
+    A ``Lambda`` of the form ``d -> f(d)``, as created by ``applyfunc`` and
+    ``ArrayElementwiseApplyFunc`` when given a function, is replaced by ``f``
+    so that it is printed as ``f_o(A)`` rather than as a lambda. Anything else
+    is returned unchanged.
+    """
+    if isinstance(func, Lambda) and len(func.variables) == 1:
+        body = func.expr
+        if isinstance(body, Function) and body.args == func.variables:
+            return body.func
+    return func
+
+
