+def test_trigsimp_leaves_unrelated_terms():
+    x, y = symbols('x y')
+    e = (y**2 - 1)/(y - 1)
+    assert trigsimp(e + sin(x)**2 + cos(x)**2) == e + 1
+    assert trigsimp(e + 1 - sin(x)**2) == e + cos(x)**2
+    assert trigsimp(e) == e
+
