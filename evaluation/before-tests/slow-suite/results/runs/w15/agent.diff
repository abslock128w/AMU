diff --git a/sympy/core/tests/test_power.py b/sympy/core/tests/test_power.py
index 45e6f10..419fbc1 100644
--- a/sympy/core/tests/test_power.py
+++ b/sympy/core/tests/test_power.py
@@ -681,3 +681,14 @@ def test_issue_28219():
     assert Pow(S.Zero, -1, evaluate=False).as_real_imag() == (S.NaN, S.NaN)
     x = Symbol('x', real=True)
     assert Pow(x, -1, evaluate=False).as_real_imag() == (1/x, S.Zero)
+
+
+def test_zero_base_is_algebraic():
+    n = Symbol('n', negative=True)
+    m = Symbol('m', nonnegative=True)
+    assert Pow(S.Zero, -1, evaluate=False).is_algebraic is False
+    assert Pow(S.Zero, n, evaluate=False).is_algebraic is False
+    assert Pow(S.Zero, 2, evaluate=False).is_algebraic is True
+    assert Pow(S.Zero, 0, evaluate=False).is_algebraic is True
+    assert Pow(S.Zero, m, evaluate=False).is_algebraic is True
+    assert Pow(S.Zero, x, evaluate=False).is_algebraic is None
