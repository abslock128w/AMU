+def elementwise_function(func):
+    """Return the function to print for an elementwise function application
+
+    A ``Lambda`` of the form ``Lambda(d, f(d))`` is replaced by ``f`` itself,
+    so that it can be printed by name. Any other function is returned
+    unchanged.
+
+    Examples
+    ========
+
+    >>> from sympy import Lambda, exp, symbols
+    >>> from sympy.printing.conventions import elementwise_function
+    >>> x = symbols('x')
+    >>> elementwise_function(Lambda(x, exp(x)))
+    exp
+    >>> elementwise_function(Lambda(x, 1/x))
+    Lambda(x, 1/x)
+
+    """
+    if isinstance(func, Lambda) and len(func.variables) == 1:
+        body = func.expr
+        if (isinstance(body, Function)
+                and isinstance(body.func, FunctionClass)
+                and body.args == func.variables):
+            return body.func
+    return func
+
+
