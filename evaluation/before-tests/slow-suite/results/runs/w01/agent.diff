+
+
+def elementwise_function(func):
+    """Return the function to display for an elementwise application
+
+    A ``Lambda`` of the form ``Lambda(d, f(d))`` is replaced by ``f``, so that
+    it can be printed by name. Any other function is returned unchanged.
+
+    Examples
+    ========
+
+    >>> from sympy import Lambda, Symbol, exp
+    >>> from sympy.printing.conventions import elementwise_function
+    >>> d = Symbol('d')
+    >>> elementwise_function(Lambda(d, exp(d)))
+    exp
+    >>> elementwise_function(Lambda(d, 1/d))
+    Lambda(d, 1/d)
+    """
+    if isinstance(func, Lambda) and len(func.variables) == 1:
+        body = func.expr
+        if isinstance(body, Function) and body.args == func.variables:
+            return type(body)
+    return func
