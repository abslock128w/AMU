@@ -0,0 +1,11 @@
+from sympy.polys.domains import QQ
+from sympy.polys.rings import ring
+from sympy.polys.puiseux import puiseux_ring
+from sympy.polys.ring_series import rs_nth_root, rs_sin
+
+def test_a():
+    R, x, y = puiseux_ring('x, y', QQ)
+    r = rs_nth_root(8*x + x**2*y + x**3, 3, x, 4)
+    r2 = rs_nth_root(8*x + x**2 + x**3, 3, x, 5)
+    r3 = rs_nth_root(8*x + x**2 + x**3, 3, x, 3)
+    assert 0, (repr(r), repr(r2), repr(r3))
