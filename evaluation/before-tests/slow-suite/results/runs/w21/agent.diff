@@ -98,7 +98,8 @@ def int_to_Integer(s):
     This is based on the decistmt example from
     https://docs.python.org/3/library/tokenize.html.
 
-    Only integer literals are converted.  Float literals are left alone.
+    Only integer literals are converted.  Float literals are left alone.  The
+    rest of the source, including whitespace and comments, is preserved.
 
     Examples
     ========
@@ -107,16 +108,16 @@ def int_to_Integer(s):
     >>> from sympy.interactive.session import int_to_Integer
     >>> s = '1.2 + 1/2 - 0x12 + a1'
     >>> int_to_Integer(s)
-    '1.2 +Integer (1 )/Integer (2 )-Integer (0x12 )+a1 '
+    '1.2 + Integer(1)/Integer(2) - Integer(0x12) + a1'
     >>> s = 'print (1/2)'
     >>> int_to_Integer(s)
-    'print (Integer (1 )/Integer (2 ))'
+    'print (Integer(1)/Integer(2))'
     >>> exec(s)
     0.5
     >>> exec(int_to_Integer(s))
     1/2
     """
-    from tokenize import generate_tokens, untokenize, NUMBER, NAME, OP
+    from tokenize import generate_tokens, NUMBER
     from io import StringIO
 
     def _is_int(num):
@@ -128,19 +129,33 @@ def _is_int(num):
             return False
         return True
 
-    result = []
-    g = generate_tokens(StringIO(s).readline)  # tokenize the string
-    for toknum, tokval, _, _, _ in g:
-        if toknum == NUMBER and _is_int(tokval):  # replace NUMBER tokens
-            result.extend([
-                (NAME, 'Integer'),
-                (OP, '('),
-                (NUMBER, tokval),
-                (OP, ')')
-            ])
-        else:
-            result.append((toknum, tokval))
-    return untokenize(result)
+    lines = StringIO(s).readlines()
+    line_offsets = [0]
+    for line in lines:
+        line_offsets.append(line_offsets[-1] + len(line))
+
+    spans = []
+    for toknum, tokval, start, end, _ in generate_tokens(StringIO(s).readline):
+        if toknum == NUMBER and _is_int(tokval):
+            spans.append((line_offsets[start[0] - 1] + start[1],
+                          line_offsets[end[0] - 1] + end[1]))
+
+    for start, end in reversed(spans):
+        s = s[:start] + 'Integer(' + s[start:end] + ')' + s[end:]
+    return s
+
+
+def _int_to_Integer_transformer(lines):
+    """IPython input transformer applying :func:`int_to_Integer` to a cell. """
+    import ast
+    cell = ''.join(lines)
+    try:
+        # Syntax errors should be reported for the original input, not the
+        # transformed input.
+        ast.parse(cell)
+    except SyntaxError:
+        return lines
+    return int_to_Integer(cell).splitlines(True)
 
 
 def enable_automatic_int_sympification(shell):
@@ -148,6 +163,13 @@ def enable_automatic_int_sympification(shell):
     Allow IPython to automatically convert integer literals to Integer.
     """
     import ast
+
+    if hasattr(shell, 'input_transformers_post'):
+        # The transformer runs after IPython has stored the raw cell, so the
+        # history keeps the original input.
+        shell.input_transformers_post.append(_int_to_Integer_transformer)
+        return
+
     old_run_cell = shell.run_cell
 
