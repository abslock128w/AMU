+def elementwise_function(function):
+    """Return the function to print for an elementwise application
+
+    A ``Lambda`` of the form ``Lambda(d, f(d))`` is replaced by ``f``, so
+    that it can be printed by name. Any other function is returned as is.
+
+    Examples
+    ========
+
+    >>> from sympy import Lambda, exp
+    >>> from sympy.abc import d
+    >>> from sympy.printing.conventions import elementwise_function
+    >>> elementwise_function(Lambda(d, exp(d)))
+    exp
+    >>> elementwise_function(Lambda(d, 2*d))
+    Lambda(d, 2*d)
+
+    """
+    if isinstance(function, Lambda) and len(function.signature) == 1:
+        body = function.expr
+        if isinstance(body, Function) and body.args == tuple(function.signature):
+            return body.func
+    return function
+
+
