+def _split_inert_terms(e):
+    """Split the Add ``e`` into ``(inert, rest)`` where ``inert`` is the sum
+    of the terms that are free of trigonometric functions and cannot take
+    part in a trigonometric identity with the remaining terms (``rest``).
+
+    A trig-free term takes part in an identity when its non-numeric part
+    matches the trig-free coefficient of a term containing trig functions
+    (e.g. the ``1`` in ``1 - cos(x)**2`` or the ``x**2`` in
+    ``x**2 - x**2*cos(x)**2``).
+    """
+    if not e.is_commutative:
+        return S.Zero, e
+    ind, dep = e.as_independent(TrigonometricFunction, as_Add=True)
+    if ind is S.Zero:
+        return S.Zero, e
+    keys = set()
+    for t in Add.make_args(dep):
+        c = t.as_independent(TrigonometricFunction)[0]
+        for ci in Add.make_args(expand_mul(c)) + (c,):
+            keys.add(ci.as_coeff_Mul()[1])
+    inert = []
+    rest = [dep]
+    for t in Add.make_args(ind):
+        if t.as_coeff_Mul()[1] in keys:
+            rest.append(t)
+        else:
+            inert.append(t)
+    return Add(*inert), Add(*rest)
