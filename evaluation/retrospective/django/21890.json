    "signature_changed": false
   },
   {
    "after": "def get_geom_placeholder_sql(self, f, value, compiler):\n    \"\"\"\n    Provide a proper substitution value for Geometries or rasters that are\n    not in the SRID of the field. Specifically, this routine will\n    substitute in the ST_Transform() function call.\n    \"\"\"\n    transform_func = self.spatial_function_name(\"Transform\")\n    if hasattr(value, \"as_sql\"):\n        sql, params = compiler.compile(value)\n        if self._must_transform_value(value.field, f):\n            sql = f\"{transform_func}({sql}, %s)\"\n            params = (*params, f.srid)\n        return sql, params\n\n    # Adding Transform() to the SQL placeholder if the value srid\n    # is not equal to the field srid.\n    if self._must_transform_value(value, f):\n        return f\"{transform_func}(%s, %s)\", (value, f.srid)\n    return \"%s\", (value,)\n",
    "before": "def get_geom_placeholder_sql(self, f, value, compiler):\n    \"\"\"\n    Provide a proper substitution value for Geometries or rasters that are\n    not in the SRID of the field. Specifically, this routine will\n    substitute in the ST_Transform() function call.\n    \"\"\"\n    transform_func = self.spatial_function_name(\"Transform\")\n    if hasattr(value, \"as_sql\"):\n        sql, params = compiler.compile(value)\n        if value.field.srid != f.srid:\n            sql = f\"{transform_func}({sql}, %s)\"\n            params = (*params, f.srid)\n        return sql, params\n\n    # Get the srid for this object\n    if value is None:\n        value_srid = None\n    else:\n        value_srid = value.srid\n\n    # Adding Transform() to the SQL placeholder if the value srid\n    # is not equal to the field srid.\n    if value_srid is None or value_srid == f.srid:\n        return \"%s\", (value,)\n    else:\n        return f\"{transform_func}(%s, %s)\", (value, f.srid)\n",
    "file": "django/contrib/gis/db/backends/postgis/operations.py",
    "id": "django/contrib/gis/db/backends/postgis/operations.py#PostGISOperations.get_geom_placeholder_sql",
