    "after": "def _must_transform_value(value, field):\n    if value is None:\n        return False\n    if value.srid == field.srid:\n        return False\n    if field.srid is None:\n        raise ValueError(\"Cannot transform a spatial value to an undefined SRID.\")\n    return True\n",
    "before": "def _must_transform_value(value, field):\n    return value is not None and value.srid != field.srid\n",
    "file": "django/contrib/gis/db/backends/base/operations.py",
    "id": "django/contrib/gis/db/backends/base/operations.py#BaseSpatialOperations._must_transform_value",
