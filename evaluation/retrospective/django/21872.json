    "after": "def func_supports_parameter(func, name):\n    \"\"\"Return True if function 'func' accepts a (keyword) argument 'name'.\"\"\"\n    return any(\n        param.name == name and param.kind in KEYWORD_ARG_KINDS\n        for param in _get_callable_parameters(func)\n    )\n",
