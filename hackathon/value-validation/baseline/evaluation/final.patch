+    def test_half_cent_rounds_up(self):
+        for subtotal, expected in [(1, 1), (5, 3), (7, 4)]:
+            with self.subTest(subtotal=subtotal):
+                self.assertEqual(discounted_total_cents(subtotal, 50), expected)
+
+    def test_discount_rounds_to_nearest_cent(self):
+        for subtotal, percent, expected in [(1, 51, 0), (1, 49, 1),
+                                             (5, 51, 2), (5, 49, 3)]:
+            with self.subTest(subtotal=subtotal, percent=percent):
+                self.assertEqual(discounted_total_cents(subtotal, percent), expected)
+
+    def test_large_integer_amounts(self):
+        cases = [(9007199254740993, 0, 9007199254740993),
+                 (9007199254740993, 50, 4503599627370497),
+                 (10 ** 400 + 5, 50, 5 * 10 ** 399 + 3),
+                 (10 ** 400 + 5, 100, 0)]
+        for subtotal, percent, expected in cases:
+            with self.subTest(subtotal=subtotal, percent=percent):
+                self.assertEqual(discounted_total_cents(subtotal, percent), expected)
+
+    def test_zero_subtotal(self):
+        for percent in [0, 50, 100]:
+            with self.subTest(percent=percent):
+                self.assertEqual(discounted_total_cents(0, percent), 0)
+
     def test_free_order(self):
         self.assertEqual(discounted_total_cents(2000, 100), 0)
 
