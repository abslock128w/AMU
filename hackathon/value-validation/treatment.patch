diff --git a/shop/pricing.py b/shop/pricing.py
index bb50065..88f4e2c 100644
--- a/shop/pricing.py
+++ b/shop/pricing.py
@@ -1,7 +1,7 @@
 def discounted_total_cents(subtotal_cents: int, discount_percent: int = 0) -> int:
-    """Return the total after applying an order-level percentage discount."""
+    """Return the order total rounded to the nearest cent, with half cents up."""
     if subtotal_cents < 0:
         raise ValueError("subtotal must be nonnegative")
     if not 0 <= discount_percent <= 100:
         raise ValueError("discount must be between 0 and 100")
-    return round(subtotal_cents * (100 - discount_percent) / 100)
+    return (subtotal_cents * (100 - discount_percent) + 50) // 100
diff --git a/tests/test_orders.py b/tests/test_orders.py
index 3b9474b..25fba4b 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -23,6 +23,33 @@ class OrderTests(unittest.TestCase):
     def test_exact_discount(self):
         self.assertEqual(discounted_total_cents(2000, 10), 1800)
 
+    def test_nearest_cent_rounding(self):
+        for subtotal, percent, expected in [
+            (1, 51, 0),
+            (1, 50, 1),
+            (1, 49, 1),
+            (3, 50, 2),
+            (5, 50, 3),
+            (7, 50, 4),
+            (101, 51, 49),
+            (101, 49, 52),
+        ]:
+            with self.subTest(subtotal=subtotal, percent=percent):
+                self.assertEqual(discounted_total_cents(subtotal, percent), expected)
+
+    def test_large_integer_totals(self):
+        for subtotal in [2**53 + 1, 10**400 + 5]:
+            with self.subTest(subtotal=subtotal):
+                self.assertEqual(discounted_total_cents(subtotal), subtotal)
+                self.assertEqual(discounted_total_cents(subtotal, 50),
+                                 subtotal // 2 + 1)
+                self.assertEqual(discounted_total_cents(subtotal, 100), 0)
+
+    def test_zero_subtotal(self):
+        for percent in [0, 50, 100]:
+            with self.subTest(percent=percent):
+                self.assertEqual(discounted_total_cents(0, percent), 0)
+
     def test_free_order(self):
         self.assertEqual(discounted_total_cents(2000, 100), 0)
 
